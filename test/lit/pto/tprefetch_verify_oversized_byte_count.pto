// RUN: not ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @tprefetch_rejects_negative_physical_cols() {
    %addr = arith.constant 4096 : i64
    %row_stride = arith.constant 64 : index
    %valid_cols = arith.constant 32 : index
    %valid_rows = arith.constant 16 : index
    %physical_cols = arith.constant -1 : index
    pto.tprefetch ins(%addr, %row_stride, %valid_cols, %valid_rows, %physical_cols : i64, index, index, index, index)
    return
  }
}

// CHECK: error: 'pto.tprefetch' op expects physical_cols in range [1, 65535]
