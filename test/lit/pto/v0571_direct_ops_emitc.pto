// RUN: ptoas --pto-arch=a5 %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --mlir-print-ir-after=pto-view-to-memref %s 2>&1 | FileCheck %s --check-prefix=VIEW

module attributes {pto.target_arch = "a5"} {
  func.func @v0571_direct_ops(%mem: !pto.ptr<f32>, %idx_mem: !pto.ptr<i32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c256 = arith.constant 256 : index

    %mem_view = pto.make_tensor_view %mem,
        shape = [%c256], strides = [%c1] {layout = #pto.layout<nd>}
        : !pto.tensor_view<?xf32>
    %idx_view = pto.make_tensor_view %idx_mem,
        shape = [%c16, %c16], strides = [%c16, %c1] {layout = #pto.layout<nd>}
        : !pto.tensor_view<?x?xi32>
    %mem_part = pto.partition_view %mem_view, offsets = [%c0], sizes = [%c256]
        : !pto.tensor_view<?xf32> -> !pto.partition_tensor_view<256xf32>
    %idx_part = pto.partition_view %idx_view, offsets = [%c0, %c0], sizes = [%c16, %c16]
        : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<16x16xi32>

    %idx = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %mask = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %acc_dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tload ins(%idx_part : !pto.partition_tensor_view<16x16xi32>)
              outs(%idx : !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.mgather_mask ins(%mem_part, %idx, %mask : !pto.partition_tensor_view<256xf32>, !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.mscatter_mask ins(%src, %idx, %mask : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%mem_part : !pto.partition_tensor_view<256xf32>)
    pto.mgather_cas ins(%mem_part, %idx, %src, %dst : !pto.partition_tensor_view<256xf32>, !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.acccvt outs(%acc_dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK: MGATHER_MASK(
// CHECK: MSCATTER_MASK(
// CHECK: MGATHER_CAS(
// CHECK: ACCCVT(
// VIEW: pto.mgather_mask ins({{.*}} : memref<256xf32
// VIEW-SAME: memref<16x16xi32
// VIEW-SAME: memref<16x16xi32
// VIEW-SAME: outs({{.*}} : memref<16x16xf32
// VIEW: pto.mscatter_mask ins({{.*}} : memref<16x16xf32
// VIEW-SAME: memref<16x16xi32
// VIEW-SAME: memref<16x16xi32
// VIEW-SAME: outs({{.*}} : memref<256xf32
// VIEW: pto.mgather_cas ins({{.*}} : memref<256xf32
// VIEW-SAME: memref<16x16xi32
// VIEW-SAME: memref<16x16xf32
// VIEW-SAME: memref<16x16xf32
// VIEW-SAME: outs({{.*}} : memref<16x16xf32
