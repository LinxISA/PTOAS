// RUN: ptoas %s | FileCheck %s --check-prefix=A3

module attributes {pto.target_arch = "a3"} {
  func.func @tprefetch_emitc(%dynamic_bytes: index) {
    %addr = arith.constant 4096 : i64
    %bytes = arith.constant 512 : index
    %max_bytes = arith.constant 262144 : index
    pto.tprefetch ins(%addr, %bytes : i64, index)
    pto.tprefetch ins(%addr, %max_bytes : i64, index)
    pto.tprefetch ins(%addr, %dynamic_bytes : i64, index)
    return
  }
}

// A3: TPREFETCH(
// A3: TPREFETCH(
// A3: TPREFETCH(
